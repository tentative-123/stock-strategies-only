# FinMind API (免費註冊: https://finmindtrade.com/)
FINMIND_TOKEN=your_finmind_token_here
# 單次執行硬上限（包含限流重試）
FINMIND_MAX_REQUESTS_PER_RUN=400

# Discord 頻道 Webhook（頻道設定 > 整合 > Webhooks）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# 選填：圖片日報額外發送的 Discord 頻道 Webhook
DISCORD_REPORT_WEBHOOK_URL=https://discord.com/api/webhooks/your_report_channel_webhook_id/your_report_channel_webhook_token

# Google Sheet
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account JSON (整串壓成一行)
GOOGLE_CREDS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
